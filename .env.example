# --- OCI (Oracle Cloud) --- (same variables as springbot/www)
# Env auth activates when tenancy + user + fingerprint + key are all set.
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
# Inline PEM (literal \n allowed) or a file — set one of the two:
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_REGION=us-ashburn-1
# Fallback config-file profile, used only when the variables above are empty:
# OCI_CONFIG_FILE=~/.oci/config
# OCI_PROFILE=DEFAULT

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=default
# Comma-separated AWS account ids for Cost Explorer (optional, uses caller identity when empty)
AWS_ACCOUNT_IDS=

# --- SMTP (email reports) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=cloudcost@example.com
MAIL_TO=team@example.com

# --- Scheduler ---
REPORT_CRON=0 7 * * 1
REPORT_TIMEZONE=America/Sao_Paulo

# --- HTTP server ---
PORT=3000
