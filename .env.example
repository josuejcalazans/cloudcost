# --- OCI (Oracle Cloud) ---
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_TENANCY_OCID=

# --- AWS ---
AWS_REGION=us-east-1
AWS_PROFILE=default
# Comma-separated AWS account ids for Cost Explorer (optional, uses caller identity when empty)
AWS_ACCOUNT_IDS=

# --- SMTP (email reports) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=cloudcost@example.com
MAIL_TO=team@example.com

# --- Scheduler ---
REPORT_CRON=0 7 * * 1
REPORT_TIMEZONE=America/Sao_Paulo

# --- HTTP server ---
PORT=3000
